# Copy to /etc/noktoswap/bot.env on the host, chmod 600, owned by the service user.
# Never commit the real thing — and never pass any of these as a flag, since argv
# is visible in `ps` and lands in shell history.

# The bot's EVM key. 32 bytes of hex. Generate one with `cast wallet new`.
BOT_PRIVATE_KEY=

# monero-wallet-rpc on the same host. Localhost only; see deploy/.
MONERO_WALLET_RPC=http://127.0.0.1:18082
MONERO_RPC_USER=
MONERO_RPC_PASSWORD=

# Per-chain RPC override. Public endpoints are fine for reads and rate-limited for
# a loop that polls every minute, so set your own for whichever chain you trade.
BOT_RPC_1=
BOT_RPC_11155111=

# Where keypairs are written. Relative to the working directory by default.
# Losing this loses any trade that is mid-flight — back it up.
BOT_KEYSTORE=.noktoswap-bot/keys
