# The Graph — Subgraph Studio. Two distinct credentials, both 32 hex chars.

# Query key — gateway reads once the subgraph is published.
#   https://thegraph.com/studio → API Keys
GRAPH_API_KEY=

# Deploy key — publishing to Studio.
#   https://thegraph.com/studio → <your subgraph> → Deploy Key
#   pnpm exec graph auth $GRAPH_DEPLOY_KEY
GRAPH_DEPLOY_KEY=
