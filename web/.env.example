# Server-side only. Deliberately NOT prefixed with VITE_ — anything VITE_ is
# inlined into the client bundle. The dev server attaches these to the proxied
# requests (see vite.config.ts), so no key ever reaches the browser.

# Subgraph Studio. One subgraph per chain — a manifest targets exactly one
# network — so the client asks for `/api/graph/<slug>` and this is the base the
# slug is appended to. Slugs come from web/src/lib/chains.ts.
# Note this is the *query* key, not the deploy key.
GRAPH_STUDIO_BASE=https://api.studio.thegraph.com/query/5944
GRAPH_API_KEY=

# The Graph Token API — token *discovery* for the swap selector: which ERC-20s an
# address holds, out of all that exist. Issue a JWT from your project key, or use
# a Graph Market token.
#
# The only credential here the app degrades without rather than fails: unset,
# /api/token answers 401, and the picker falls back to the curated list with
# figures read from Multicall3. Correct, just narrower — it can no longer find a
# token the list does not name. Its network enum is mainnets only regardless, so
# on Sepolia this is unavailable either way (see `coversChain`).
TOKEN_API_JWT=

# Uniswap Trading API. Sent as `x-api-key`.
UNISWAP_API_KEY=

# Optional RPC overrides, one per chain id: VITE_RPC_<chainId>, read dynamically
# in lib/wagmi.ts. Vite inlines the whole import.meta.env object, so the dynamic
# key does survive a production build — verified by probing dist/ for the value.
#
# Unset falls back to viem's public endpoint, and measurement says that is fine:
# 12 concurrent reads on each configured chain returned 60/60 in under 250ms
# apiece. Set one only if you see throttling.
#
# Worth knowing which chains matter, since it is not the obvious list. Chainlink's
# mainnet XMR/USD proxy is decommissioned and reverts, so lib/oracle.ts reads the
# Optimism pair regardless of the wallet's chain — chain 10 is on the rate
# ladder's critical path despite having no deployment.
#
#   1          mainnet       deployed, indexed, offered
#   8453       base          deployed, indexed, offered
#   11155111   sepolia       deployed, indexed, offered
#   84532      base sepolia  deployed, not indexed, offered
#   10         optimism      READ_ONLY_CHAINS — never offered, but the Chainlink
#                            feeds live here, so wagmi needs a transport for it
VITE_RPC_1=
VITE_RPC_10=
VITE_RPC_11155111=
