# Server-side only. Deliberately NOT prefixed with VITE_ — anything VITE_ is
# inlined into the client bundle. The dev server attaches these to the proxied
# requests (see vite.config.ts), so no key ever reaches the browser.

# Subgraph Studio. One subgraph per chain — a manifest targets exactly one
# network — so the client asks for `/api/graph/<slug>` and this is the base the
# slug is appended to. Slugs come from web/src/lib/chains.ts.
# Note this is the *query* key, not the deploy key.
GRAPH_STUDIO_BASE=https://api.studio.thegraph.com/query/5944
GRAPH_API_KEY=

# The Graph Token API — wallet balances for the swap token selector.
# Issue a JWT from your project key, or use a Graph Market token.
TOKEN_API_JWT=

# Uniswap Trading API. Sent as `x-api-key`.
UNISWAP_API_KEY=

# Optional RPC overrides, one per chain id. Unset falls back to the public
# endpoint, which is rate-limited — set at least the home chain before demoing.
VITE_RPC_11155111=
